rules_version = '2';

// users/{uid} = public leaderboard row + private-ish profile.
// Anyone may read (the leaderboard is public); only the owner may write,
// and the score can never go down or be non-integer.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validProfile(request.resource.data)
                    && validScore(request.resource.data.get('highScore', 0));

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && validProfile(request.resource.data)
                    && validScore(request.resource.data.get('highScore', 0))
                    && request.resource.data.get('highScore', 0) >= resource.data.get('highScore', 0);

      // Only the owner can delete their own row (in-app "Delete account").
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }

  function validProfile(d) {
    return d.username is string
        && d.username.size() >= 3 && d.username.size() <= 16
        && d.countryCode is string
        && d.countryCode.size() <= 2;
  }

  function validScore(s) {
    return s is int && s >= 0 && s < 100000000;
  }
}
